# Copy this file to .env and fill in your values.

# The live SmartDesk AI backend to attack (direct + history attacks)
TARGET_URL=https://smartdesk-ai-backend-9h4d.onrender.com

# Same free Groq key used elsewhere in your projects -- used as the judge LLM
GROQ_API_KEY=your_groq_api_key_here

# Path to a LOCAL smartdesk-ai checkout (for indirect/data-poisoning attacks
# only -- these are never run against the live deployment or real data)
SMARTDESK_PATH=../smartdesk-ai
